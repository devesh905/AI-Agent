"""

import os
from groq import Groq

# Import database functions
import sys
sys.path.append("/home/devesh/ai-asterisk")
from database import (
    check_medicine_availability, 
    add_medicine_to_inventory,
    create_order,
    update_stock
)

GROQ_API_KEY = os.environ.get("GROQ_API_KEY", "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")
client = Groq(api_key=GROQ_API_KEY)

# Conversation history
conversation_history = []
current_caller = None  # Store caller number for orders


def transcribe_audio_groq(audio_file):
    """
    Transcribe audio using Groq Whisper
    UNCHANGED - keeps existing functionality
    """
    try:
        with open(audio_file, "rb") as file:
            transcription = client.audio.transcriptions.create(
                file=(audio_file, file.read()),
                model="whisper-large-v3",
                language="en",
                temperature=0.0,
                response_format="json"
            )
        return transcription.text.strip()
    except Exception as e:
        print(f"Groq STT Error: {e}")
        return ""


def extract_medicine_intent(user_text):
    """
    Extract medicine name and intent from user input
    Returns: (intent, medicine_name, quantity)
    
    Intents: 'order', 'check', 'none'
    """
    text_lower = user_text.lower()
    
    # NEGATIVE keywords - if these are present, it's NOT a medicine order
    negative_keywords = [
        "lab", "scan", "test", "doctor", "appointment", "opd", "emergency",
        "where", "location", "direction", "how to reach", "timing", "hours",
        "pharmacy location", "hospital", "department", "ward"
    ]
    
    # If negative keywords found, return none immediately
    if any(word in text_lower for word in negative_keywords):
        return ("none", None, 1)
    
    # Keywords for ordering - must be EXPLICIT
    order_keywords = ["order", "buy", "deliver", "book", "purchase", "i want", "i need", "get me"]
    check_keywords = ["available", "have", "stock", "check", "do you have"]
    
    # Common medicine names (expand this list)
    medicine_list = [
        "paracetamol", "aspirin", "ibuprofen", "amoxicillin", 
        "cetirizine", "dolo", "crocin", "combiflam", "citrigen",
        "disprin", "avil", "azithromycin", "cough syrup", "tablet"
    ]
    
    # Detect intent - must have BOTH order keyword AND medicine
    has_order_word = any(word in text_lower for word in order_keywords)
    has_check_word = any(word in text_lower for word in check_keywords)
    
    # Extract medicine name
    medicine_name = None
    for med in medicine_list:
        if med in text_lower:
            medicine_name = med
            break
    
    # If no match from list, try to extract after order keywords
    if not medicine_name and (has_order_word or has_check_word):
        words = text_lower.split()
        for i, word in enumerate(words):
            if word in ["order", "buy", "want", "need", "get"] and i + 1 < len(words):
                potential_med = words[i + 1]
                # Only if it looks like a medicine name (not common words)
                common_words = ["to", "know", "about", "some", "help", "information"]
                if potential_med not in common_words and len(potential_med) > 3:
                    medicine_name = potential_med
                    break
    
    # Determine intent ONLY if medicine is found
    intent = "none"
    if medicine_name:
        if has_order_word:
            intent = "order"
        elif has_check_word:
            intent = "check"
    
    # Extract quantity (default 1)
    quantity = 1
    for word in user_text.split():
        if word.isdigit():
            quantity = int(word)
            break
    
    return intent, medicine_name, quantity


def handle_medicine_order(medicine_name, quantity, caller_number):
    """
    Handle medicine ordering logic with database
    Returns: response_text
    """
    if not medicine_name:
        return "I couldn't identify the medicine. Could you please repeat the name?"
    
    # Check availability
    available, stock, price, actual_name = check_medicine_availability(medicine_name)
    
    if available:
        if stock >= quantity:
            # Create order
            order_id = create_order(caller_number, actual_name, quantity)
            # Reduce stock
            update_stock(actual_name, -quantity)
            
            total_price = price * quantity
            return (f"Great! {actual_name} is available. "
                   f"We'll deliver {quantity} unit{'s' if quantity > 1 else ''} to you. "
                   f"Total cost is {total_price} rupees. Your order number is {order_id}.")
        else:
            return (f"{actual_name} is currently low in stock. "
                   f"We only have {stock} units available. "
                   f"Would you like to order those?")
    else:
        # Medicine not in stock - add to inventory as "out of stock"
        add_medicine_to_inventory(medicine_name.title(), quantity=0, price=0.0)
        
        # Create a pending order
        order_id = create_order(caller_number, medicine_name.title(), quantity)
        
        return (f"We currently don't have {medicine_name} in stock, "
               f"but I've noted your request. "
               f"We'll arrange it and deliver to you soon. Your order number is {order_id}.")


def get_groq_response(user_text, system_prompt=None, caller_number="unknown"):
    """
    Enhanced AI response with database integration
    BACKWARDS COMPATIBLE - if no medicine intent, works like before
    """
    global current_caller
    current_caller = caller_number
    
    # First, check if this is a medicine order
    intent, medicine_name, quantity = extract_medicine_intent(user_text)
    
    if intent == "order" and medicine_name:
        # Handle medicine ordering through database
        response = handle_medicine_order(medicine_name, quantity, caller_number)
        
        # Add to conversation history
        conversation_history.append({"role": "user", "content": user_text})
        conversation_history.append({"role": "assistant", "content": response})
        
        return response
    
    # Otherwise, use normal AI response (UNCHANGED BEHAVIOR)
    if system_prompt is None:
        system_prompt = """You are Lucy, a helpful AI assistant for Subharti Hospital in Meerut, India.

IMPORTANT: Keep responses SHORT (2-3 sentences maximum). This is a phone call.

**Your Capabilities:**
1. HOSPITAL INFORMATION: Answer questions about departments, locations, timings
2. MEDICINE ORDERS: Process medicine orders when users explicitly want to buy/order

**CRITICAL RULES:**
- DO NOT treat general queries as medicine orders
- Only process medicine orders when user says: "I want to ORDER/BUY [medicine]"
- Questions about lab/scan/test are NOT medicine orders
- Questions about location/timing are NOT medicine orders

**Hospital Information:**
- OPD: Gate 2, Ground Floor, Mon-Sat 8AM to 4PM
- Emergency: Main Entrance (Front of Gol Chakker), 24/7
- Lab: Main Building, Ground Floor, 8AM-4PM (Emergency tests 24/7)
- Pharmacy: Ground Floor near Gate 3, 24/7
- Helpline: 09639010313

**Rules:**
- Be warm and professional
- Give clear, simple directions
- Don't give medical advice - say "please consult a doctor"
- Keep it conversational and natural
- For medicine orders, the system will automatically check availability
"""
    
    conversation_history.append({"role": "user", "content": user_text})
    
    if len(conversation_history) > 6:
        conversation_history.pop(0)
        conversation_history.pop(0)
    
    try:
        chat_completion = client.chat.completions.create(
            messages=[
                {"role": "system", "content": system_prompt},
                *conversation_history
            ],
            model="llama-3.3-70b-versatile",
            temperature=0.7,
            max_tokens=150,
            top_p=1,
            stream=False
        )
        
        response = chat_completion.choices[0].message.content
        conversation_history.append({"role": "assistant", "content": response})
        
        return response
        
    except Exception as e:
        print(f"Groq AI Error: {e}")
        return "I'm having trouble processing that. Please call our helpline at 0121-2439056."


def reset_conversation():
    """Reset conversation history for new call"""
    global conversation_history, current_caller
    conversation_history = []
    current_caller = None
